{
  "name": "meu-ifood",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n admin,mobile -c blue,green \"npm:dev:admin\" \"npm:dev:mobile\"",
    "dev:admin": "vite",
    "dev:mobile": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mobile-dev.ps1",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages-admin.mjs",
    "build:embed-admin": "node scripts/embed-admin-into-public-app.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
